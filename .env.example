DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional path on Windows (otherwise Tesseract must be on PATH)
DOCUPILOT_TESSERACT_CMD=
DOCUPILOT_OCR_LANG=eng

# Optional semantic/hybrid retrieval. Requires backend/requirements-semantic.txt.
DOCUPILOT_EMBEDDING_MODEL=intfloat/multilingual-e5-small
DOCUPILOT_MODEL_OFFLINE=false
DOCUPILOT_SEMANTIC_MIN_SCORE=0.40

# Optional async processing: leave false for the normal synchronous MVP.
DOCUPILOT_ASYNC_ENABLED=false
DOCUPILOT_REDIS_URL=redis://127.0.0.1:6379/0

# Worker recovery thresholds (minutes, operator-initiated only)
DOCUPILOT_STALE_QUEUE_MINUTES=30
DOCUPILOT_STALE_RUNNING_MINUTES=120

# Production: set DJANGO_DEBUG=false and a unique >=50-character DJANGO_SECRET_KEY.
# Set this only after HTTPS and TLS termination are configured.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_TRUST_PROXY_HTTPS=false
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SESSION_AGE=3600
DOCUPILOT_SESSION_IDLE_SECONDS=1800
DOCUPILOT_LOGIN_FAILURE_LIMIT=5
DOCUPILOT_LOGIN_WINDOW_SECONDS=900
# Development-only opt-in Basic access for legacy API clients (never production):
DOCUPILOT_ALLOW_DEV_BASIC=false
